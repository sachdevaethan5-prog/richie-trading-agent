# Copy to .env and fill in. `npm start`, `npm run watch`, `npm run signin` and `npm run check` load it.
# Never commit .env. On a Mac you can instead keep secrets in the Keychain with `node src/setup.mjs <name>`.

# Required: OpenRouter API key (https://openrouter.ai/keys). Pays for the model calls, usually cents a day.
RICHIE_OPENROUTER=

# Required: Telegram bot token from @BotFather, and your own chat id (Richie answers only this chat).
RICHIE_TELEGRAM_TOKEN=
RICHIE_TELEGRAM_CHAT_ID=

# Robinhood and Kalshi credentials are saved by their own commands, not here:
#   npm run signin                                        Robinhood (OAuth in your browser)
#   node src/core/kalshi.mjs --save <key id> <key file>   Kalshi API key

# How much of the Robinhood account Richie trades himself, a whole number from 0 to 100 (default 20).
# Code keeps the rest in SPY: it buys SPY from cash and never sells it to fund a trade. 100 means no SPY at all (idle
# cash stays in cash); 0 means all SPY. In the long-history test 20 trailed SPY by 0.1 to 1.3 points a year and 65 by
# 0.7 to 4.7 points a year since 2015 (docs/history-backtest.md): a bigger share is a bigger bet on Richie.
# RICHIE_TRADING_PERCENT=20

# Optional settings
# RICHIE_HOME=~/.richie                       data folder: ledger, journal, lessons, logs, secrets on non-Mac systems
# RICHIE_MODEL=deepseek/deepseek-v4.1-flash   OpenRouter model for sessions, chat and research
# RICHIE_REVIEW_MODEL=~deepseek/deepseek-pro-latest   OpenRouter model that must PASS every buy
# RICHIE_CHROME=/usr/bin/chromium             Chrome or Chromium for reading research pages (macOS Chrome is found by default)
# RICHIE_SKILLS_DIR=                          extra folder of SKILL.md skills
# RICHIE_MEMORY_URL=                          an MCP memory server; also set RICHIE_MEMORY to its key
# RICHIE_APP_URL=                             HTTPS URL of your dashboard, for the Telegram "Open dashboard" button
# RICHIE_PORT=8792                            dashboard port
# RICHIE_CONTROLS=on                          set to off for a view-only dashboard
# RICHIE_KEYCHAIN=on                          set to off to keep secrets out of the macOS Keychain
